# Copy this file to .env and fill in the three sets of keys. All have free tiers.

# LiveKit Cloud — https://cloud.livekit.io (project settings -> API keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google AI Studio (Gemini, the LLM) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Sarvam AI (speech-to-text and the voice) — https://dashboard.sarvam.ai
SARVAM_API_KEY=

# ---- Optional tuning (defaults shown) ----
# FRIDAY_LLM_MODEL=gemini-3.1-flash-lite,gemini-2.5-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# FRIDAY_STT_MODEL=saaras:v3
# FRIDAY_STT_LANGUAGE=en-IN
# FRIDAY_TTS_MODEL=bulbul:v3
# FRIDAY_TTS_VOICE=priya
# FRIDAY_TTS_PACE=1.1
# FRIDAY_USER_TITLE=boss
# FRIDAY_HOST=127.0.0.1
# FRIDAY_PORT=8000

# Needed only when the HUD is hosted away from this machine (e.g. on Vercel):
# the page asks for this code before it hands out a session.
# FRIDAY_ACCESS_CODE=
